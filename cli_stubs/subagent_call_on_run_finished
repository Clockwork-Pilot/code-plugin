#!/usr/bin/env bash
# CLI stub for the "subagent_call_on_finished_if_resolved" event (config.HOOK_CLI_CALLS),
# invoked once by hooks/handler_subagent_stop.py when a sub-agent whose ledger carries
# a detected run_id stops -- ONLY once the {run_id} placeholder actually resolves (see
# hook_cli_calls.py's _fill: an unresolvable placeholder makes this call a no-op).
# Called as:
#   subagent_call_on_finished_if_resolved <run_id> --fact agent_finished
#
# This default stub logs the args it was invoked with to cli_stubs/cli_stubs.log,
# then always exits 0. Replace this script to record a definite end marker
# somewhere real.
log_file="$(dirname "$0")/cli_stubs.log"
script_rel="$(basename "$(dirname "$0")")/$(basename "$0")"
echo "$(date +'%Y-%m-%d %H:%M:%S,%3N') \`$script_rel $*\`" >> "$log_file"
exit 0
