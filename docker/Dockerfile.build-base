# manylinux_2_28 (AlmaLinux 8, glibc 2.28): the PyPA baseline for portable Linux
# binaries. It is an older glibc floor than any distro we target, and unlike a Debian
# release it does not depend on a mirror that stops serving packages when its LTS ends
# (see docker/Dockerfile.build-linux for why the floor exists). It already ships gcc and
# patchelf, plus CPython builds under /opt/python.
FROM --platform=linux/amd64 quay.io/pypa/manylinux_2_28_x86_64

# python:3.11 rather than the distro's own python3: the system one is too old for the
# PEP 604 `str | None` annotations this codebase uses. Put it first on PATH so
# `python3 -m venv` in the build image picks it up.
ENV PATH=/opt/python/cp311-cp311/bin:${PATH}

# manylinux's CPython has no shared libpython; Nuitka links the static one, which the
# image ships as a tarball "for embedding only" until it is unpacked.
RUN cd /opt/_internal && tar xf static-libs-for-embedding-only.tar.xz

RUN dnf install -y epel-release \
 && dnf install -y ccache git \
 && dnf clean all \
 && command -v gcc \
 && command -v patchelf
