      {"matcher": "Edit", "hooks": [{"type": "command", "command": "CWPILOT_AGENT_PROVIDER=codex \"${CLAUDE_PLUGIN_ROOT}/dist/run-hook.sh\" handler_post_change"}]},
      {"matcher": "Write", "hooks": [{"type": "command", "command": "CWPILOT_AGENT_PROVIDER=codex \"${CLAUDE_PLUGIN_ROOT}/dist/run-hook.sh\" handler_post_change"}]}
    ],
    "PostToolUseFailure": [
