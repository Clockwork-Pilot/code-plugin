    ],
    "SessionStart": [{"matcher": "*", "hooks": [{"type": "command", "command": "CWPILOT_AGENT_PROVIDER=codex \"${CLAUDE_PLUGIN_ROOT}/dist/run-hook.sh\" handler_session_start"}]}],
    "Compaction": [{"hooks": [{"type": "command", "command": "CWPILOT_AGENT_PROVIDER=codex \"${CLAUDE_PLUGIN_ROOT}/dist/run-hook.sh\" handler_compaction"}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "CWPILOT_AGENT_PROVIDER=codex \"${CLAUDE_PLUGIN_ROOT}/dist/run-hook.sh\" handler_stop"}]}],
    "SubagentStart": [{"hooks": [{"type": "command", "command": "CWPILOT_AGENT_PROVIDER=codex \"${CLAUDE_PLUGIN_ROOT}/dist/run-hook.sh\" handler_subagent_start"}]}],
    "SubagentStop": [{"hooks": [{"type": "command", "command": "CWPILOT_AGENT_PROVIDER=codex \"${CLAUDE_PLUGIN_ROOT}/dist/run-hook.sh\" handler_subagent_stop"}] }]
